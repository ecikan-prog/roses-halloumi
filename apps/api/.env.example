DATABASE_URL="******host:3306/dairy_sales"
JWT_SECRET="change-me"
PORT=4000
ALLOWED_ORIGINS="http://localhost:19006,http://localhost:8081"
# Absolute base URL of the deployed customer-facing web app, used to build
# "forgot your password" reset links (e.g. https://shop.grasslandcheese.com).
# If unset, the request's Origin header is used instead.
APP_BASE_URL=
# Brevo SMTP relay credentials used by sendMail() for all transactional
# emails (welcome, password reset, order confirmation). If SMTP_HOST is
# unset, emails are logged instead of sent (e.g. local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Overrides the "Name <email@domain>" sender identity for all transactional
# emails. Must be an address on the authenticated/verified Grassland Cheese
# sending domain. If unset, falls back to info@grasslandcheese.com.
MAIL_FROM=
# Recipient for admin-facing transactional notifications (e.g. contact form
# submissions, new order alerts). Unused until an admin-facing notification
# email is implemented.
ADMIN_EMAIL=
