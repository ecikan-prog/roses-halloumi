{
  "expo": {
    "name": "Grassland",
    "slug": "dairy-sales",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grasslandcheese.app",
      "buildNumber": "2",
      "icon": "./assets/grassland-cheese-app-icon.png",
      "splash": {
        "image": "./assets/grassland-cheese-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app does not require local network access.",
        "NSBonjourServices": [],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.grasslandcheese.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/grassland-cheese-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": ["SYSTEM_ALERT_WINDOW", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/grassland-cheese-logo.png"
    }
  }
}
