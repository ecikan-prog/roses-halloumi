generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum AccountSource {
  SELF_REGISTERED
  STAFF_CREATED
}

enum OrderStatus {
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentTerm {
  PAY_NOW
  PAY_30
}

enum PaymentStatus {
  PAID
  OUTSTANDING
  OVERDUE
}

enum PaymentMethod {
  IN_APP
  EFTPOS
}

enum StaffRole {
  STAFF
  ADMIN
}

model Customer {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  passwordHash         String
  type                 CustomerType          @default(RETAIL)
  contact              String?
  accountSource        AccountSource
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  /// Soft-delete marker. When set, this customer account is deactivated: the
  /// customer can no longer log in (or use an existing session token), but
  /// the row — and any historical orders that reference it via
  /// `Order.customerId` — is preserved for accounting/audit purposes rather
  /// than being hard-deleted, which would otherwise violate the FK on
  /// `Order.customerId` or destroy order history.
  deletedAt            DateTime?
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
}

/**
 * Single-use, time-limited tokens issued for the customer "forgot your
 * password" flow. Only a SHA-256 hash of the token is ever stored — the
 * plaintext token is emailed to the customer and never persisted — so a
 * database read alone can never be used to reset an account's password.
 */
model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  customerId Int
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Product {
  id             Int         @id @default(autoincrement())
  name           String      @unique
  unit           String
  wholesalePrice Decimal     @db.Decimal(10, 2)
  retailPrice    Decimal     @db.Decimal(10, 2)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model Recipe {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String
  image       String
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id               Int            @id @default(autoincrement())
  orderNumber      String?        @unique
  customerId       Int
  staffId          Int?
  status           OrderStatus    @default(CONFIRMED)
  paymentTerm      PaymentTerm
  subtotal         Decimal?       @db.Decimal(10, 2)
  deliveryCharge   Decimal        @default(0) @db.Decimal(10, 2)
  deliveryAddress  String?        @db.Text
  orderNotes       String?        @db.Text
  discountApplied  Decimal        @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)
  dueDate          DateTime?
  paymentStatus    PaymentStatus  @default(OUTSTANDING)
  paymentMethod    PaymentMethod
  createdAt        DateTime       @default(now())
  confirmationEmailClaimedAt DateTime?
  confirmationEmailSentAt DateTime?
  customer         Customer       @relation(fields: [customerId], references: [id])
  staff            StaffUser?     @relation(fields: [staffId], references: [id])
  orderItems       OrderItem[]

  @@index([customerId, paymentStatus])
  @@index([staffId])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  qty        Decimal  @db.Decimal(10, 2)
  unitPrice  Decimal  @db.Decimal(10, 2)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model StaffUser {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         StaffRole  @default(STAFF)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
}
